# ABOUTME: Committed non-secret env for NETWORK=mainnet (spec §7.2, §11.1). Mainnet is a
# ABOUTME: configuration posture: this file must stay valid even before mainnet manifests exist.
NETWORK=mainnet

# Watcher run mode. "full" (default) indexes the privacy pools from their deploy block — powering
# quick-sync and the pool read endpoints — alongside forward-only CCTP. "cctp-only" is a lean
# relay-only node: it indexes ONLY the CCTP transmitter (from chain head), performs no pool
# backfill or indexing, and serves no quick-sync. Relaying is unaffected. Uncomment to enable.
#WATCHER_MODE=cctp-only

# Central deployment registry (spec §7.2). No mainnet instance is published yet, so this is
# intentionally unset: boot fails loudly until a mainnet instance exists and is named here.
# DEPLOYMENT_INSTANCE=<mainnet-instance>

POSTGRES_PASSWORD=change-me-in-secrets-env
WATCHER_DB_PASSWORD=change-me-in-secrets-env
ACTOR_DB_PASSWORD=change-me-in-secrets-env

# Per-chain RPC endpoints live in endpoints.env (one var per chain, named by topology.json's
# rpcUrlEnv — ETHEREUM_RPC / BASE_RPC / ARBITRUM_RPC by default). Comma-separated lists are
# allowed: the watcher pools every URL, the actor uses the first. ENABLED_CLIENTS (unset ⇒ all)
# selects a subset of clients. Boot fails loudly if a run chain's RPC var is unset.

# Chainlink ETH/USD on Ethereum mainnet (hub chain, §8.8).
ETH_USD_FEED_ADDRESS=0x5f4eC3Df9cbd43714FE2740f5E3616155c5b8419
# Verified against the live feed via `npx tsx e2e/verify-feed.mts` (actor package);
# update when ETH moves materially.
ETH_USD_PRICE_STATIC=1800
