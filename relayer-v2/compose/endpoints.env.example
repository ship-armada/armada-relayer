# ABOUTME: Template for relayer-v2/compose/endpoints.env (gitignored) — per-chain RPC endpoints,
# ABOUTME: injected into BOTH the watcher and actor via env_file. One var per chain (topology.json).
# cp endpoints.env.example endpoints.env
#
# Each chain in deployments/topology.json names its own RPC env var (its `rpcUrlEnv`). Set one line
# per chain you run — the name here MUST match that chain's rpcUrlEnv. To run a new client, add it
# to topology.json and add its RPC line here; no compose edit is needed. Comma-separated lists are
# allowed: the watcher load-balances across every URL (more free-tier throughput for backfills);
# the actor uses only the FIRST entry, so put the provider you trust most for submission first.
# URLs with embedded keys are secrets — this file is gitignored; never commit the real one.

# --- local (Anvil on the host; containers reach it via host-gateway) ---
ANVIL_HUB_RPC=http://host.docker.internal:8545
ANVIL_CLIENT_A_RPC=http://host.docker.internal:8546
ANVIL_CLIENT_B_RPC=http://host.docker.internal:8547

# --- sepolia (keyless public defaults; prepend keyed URLs, e.g. https://eth-sepolia.g.alchemy.com/v2/KEY) ---
#ETHEREUM_SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com
#BASE_SEPOLIA_RPC=https://base-sepolia-rpc.publicnode.com
#ARBITRUM_SEPOLIA_RPC=https://arbitrum-sepolia-rpc.publicnode.com
#OPTIMISM_SEPOLIA_RPC=https://optimism-sepolia-rpc.publicnode.com

# --- mainnet ---
#ETHEREUM_RPC=https://ethereum-rpc.publicnode.com
#BASE_RPC=https://base-rpc.publicnode.com
#ARBITRUM_RPC=https://arbitrum-one-rpc.publicnode.com
